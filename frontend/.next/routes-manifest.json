{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/tests/attempts/[attemptId]/result",
      "regex": "^/tests/attempts/([^/]+?)/result(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId"
      },
      "namedRegex": "^/tests/attempts/(?<nxtPattemptId>[^/]+?)/result(?:/)?$"
    },
    {
      "page": "/tests/attempts/[attemptId]/review",
      "regex": "^/tests/attempts/([^/]+?)/review(?:/)?$",
      "routeKeys": {
        "nxtPattemptId": "nxtPattemptId"
      },
      "namedRegex": "^/tests/attempts/(?<nxtPattemptId>[^/]+?)/review(?:/)?$"
    },
    {
      "page": "/tests/[id]",
      "regex": "^/tests/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/tests/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tests/[id]/attempt",
      "regex": "^/tests/([^/]+?)/attempt(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/tests/(?<nxtPid>[^/]+?)/attempt(?:/)?$"
    },
    {
      "page": "/vocabulary/[id]",
      "regex": "^/vocabulary/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/vocabulary/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/generated-questions",
      "regex": "^/admin/generated\\-questions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/generated\\-questions(?:/)?$"
    },
    {
      "page": "/admin/questions",
      "regex": "^/admin/questions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/questions(?:/)?$"
    },
    {
      "page": "/admin/tests",
      "regex": "^/admin/tests(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/tests(?:/)?$"
    },
    {
      "page": "/admin/vocabulary",
      "regex": "^/admin/vocabulary(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/vocabulary(?:/)?$"
    },
    {
      "page": "/ai-tutor",
      "regex": "^/ai\\-tutor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ai\\-tutor(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/grammar-practice",
      "regex": "^/grammar\\-practice(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/grammar\\-practice(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/mistake-analysis",
      "regex": "^/mistake\\-analysis(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mistake\\-analysis(?:/)?$"
    },
    {
      "page": "/register",
      "regex": "^/register(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/register(?:/)?$"
    },
    {
      "page": "/skill-profile",
      "regex": "^/skill\\-profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skill\\-profile(?:/)?$"
    },
    {
      "page": "/study-plan",
      "regex": "^/study\\-plan(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/study\\-plan(?:/)?$"
    },
    {
      "page": "/tests",
      "regex": "^/tests(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tests(?:/)?$"
    },
    {
      "page": "/vocabulary",
      "regex": "^/vocabulary(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/vocabulary(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}